{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hkei.example/schemas/live-ab-case-1.0.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "status", "category", "subtype", "language", "source_url", "source_text", "publication_datetime", "expected_topic", "risk"],
  "properties": {
    "case_id": {"type": "string", "pattern": "^case_[0-9]{3,}$"},
    "status": {"enum": ["UNSEEN", "REGRESSION"]},
    "category": {"type": "string", "minLength": 1},
    "subtype": {"type": "string", "minLength": 1},
    "language": {"type": "string", "minLength": 2},
    "source_url": {"type": "string"},
    "source_text": {"type": "string"},
    "publication_datetime": {"type": "string"},
    "expected_topic": {"type": "string"},
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["time_sensitive", "legal", "medical", "financial", "political"],
      "properties": {
        "time_sensitive": {"type": "boolean"},
        "legal": {"type": "boolean"},
        "medical": {"type": "boolean"},
        "financial": {"type": "boolean"},
        "political": {"type": "boolean"}
      }
    }
  },
  "anyOf": [
    {"properties": {"source_url": {"type": "string", "minLength": 1}}},
    {"properties": {"source_text": {"type": "string", "minLength": 1}}}
  ]
}
